              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('10 aristas y cota 3', function () { var j = pm.response.json(); pm.expect(j.aristas.length).to.eql(10); pm.expect(j.cotaInferiorCromatica).to.eql(3); });"
                ]
              }
            }
          ]
        },
