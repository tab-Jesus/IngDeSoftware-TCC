                  "var r = pm.response.json(); pm.collectionVariables.set('reservaId', r[0].id); pm.collectionVariables.set('sesionId', r[0].sesionId); pm.collectionVariables.set('periodoId', r[0].periodoId); pm.collectionVariables.set('equipoId', r[0].equipoId);"
                ]
