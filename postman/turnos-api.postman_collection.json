              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "planificacion",
                "generar"
              ],
              "query": [
                {
                  "key": "persistir",
                  "value": "false"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Factible en 3 períodos', function () { var j = pm.response.json(); pm.expect(j.factible).to.eql(true); pm.expect(j.periodosUsados).to.eql(3); });"
                ]
              }
            }
